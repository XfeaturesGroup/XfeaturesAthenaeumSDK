{
  "name": "@xfeaturesgroup/athenaeum",
  "version": "0.2.0",
  "description": "Typed TypeScript client and types for Xfeatures Athenaeum, a secure knowledge and retrieval service for AI agents.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "xfeatures",
    "athenaeum",
    "knowledge-base",
    "knowledge-infrastructure",
    "ai-agents",
    "retrieval",
    "semantic-retrieval",
    "rag",
    "sdk",
    "rest-client",
    "typescript",
    "oauth2"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XfeaturesGroup/XfeaturesAthenaeumSDK.git",
    "directory": "packages/athenaeum"
  },
  "homepage": "https://github.com/XfeaturesGroup/XfeaturesAthenaeumSDK/tree/main/packages/athenaeum#readme",
  "bugs": {
    "url": "https://github.com/XfeaturesGroup/XfeaturesAthenaeumSDK/issues"
  }
}
